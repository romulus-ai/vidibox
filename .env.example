# Speicherort fuer Datenbank, Videos, Thumbnails und Tag-Bilder
VIDEOBOX_DATA_DIR=./data

# PIN fuer die Admin-Oberflaeche
VIDEOBOX_ADMIN_PIN=1234

# Maximale Lautstaerke in Prozent (Deckel fuer die Kinder-UI)
VIDEOBOX_MAX_VOLUME=70

# Maximale Videoaufloesung beim Download (Pixel Hoehe)
VIDEOBOX_MAX_RESOLUTION=720

# Serverport
VIDEOBOX_PORT=8000
